# Frontend Environment Variables
# Copy this file to .env.local and update with your values

# Local development
REACT_APP_API_URL=http://localhost:3001

# Production (Vercel): set REACT_APP_API_URL to your Render/Heroku backend URL
# Example: REACT_APP_API_URL=https://financify-api.onrender.com
# Also configure the same variable in Vercel → Project → Settings → Environment Variables
