# MongoDB Atlas Connection String
DATABASE_KEY=mongodb+srv://username:password@cluster.mongodb.net/financify?retryWrites=true&w=majority

# If mongodb+srv fails on Windows (querySrv / No SRV records), paste Atlas
# "standard connection string" (mongodb:// with host1,host2,host3) here:
# Atlas → Connect → Drivers → 3.6 or later still uses +srv; use Compass / "shell"
# string or the replica-set hosts from the cluster.
# DATABASE_KEY_DIRECT=mongodb://username:password@host1:27017,host2:27017,host3:27017/financify?tls=true&retryWrites=true&w=majority&authSource=admin

# Optional: local MongoDB for development only (never set on Render/production)
# USE_LOCAL_MONGODB=true
# DATABASE_KEY_LOCAL=mongodb://127.0.0.1:27017/financify

# Session Secret (min 32 chars) — generate with:
# node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
SESSION_SECRET=your-super-secret-session-key-here

PORT=3001

# ─── Production (Render / Railway / etc.) ───────────────────────────────────
NODE_ENV=production
COOKIE_SECURE=true

# Exact frontend URL(s), comma-separated (required for CORS + cookies)
ALLOWED_ORIGINS=https://financify-frontend-navy.vercel.app,http://localhost:3000

# ─── AI Receipt Parsing (OpenAI Vision) ───────────────────────────────────────
# Get a key at https://platform.openai.com/api-keys — server-only, never in React
OPENAI_API_KEY=sk-your-openai-api-key-here
# Optional: defaults to gpt-4o-mini (cost-effective vision model)
# OPENAI_MODEL=gpt-4o-mini

# Serve built React app from Express (single-host deploy). Run: npm run serve
# SERVE_CLIENT=true

# ─── Local development only ───────────────────────────────────────────────────
# NODE_ENV=development
# COOKIE_SECURE=false
# LOCAL_DEV=true
# ALLOWED_ORIGINS=http://localhost:3000
